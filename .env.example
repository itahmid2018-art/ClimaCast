# GEMINI_API_KEY: Required for Gemini AI Weather Insights & Tip of the Day.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Settings modal.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PURPLEAIR_API_KEY: Optional Read API key for HyperLocal community AQI sensor telemetry.
# Get a free read key at: https://develop.purpleair.com
PURPLEAIR_API_KEY=

# OPENWEATHERMAP_API_KEY: Optional key for high-resolution weather radar & cloud tiles in Classic Leaflet mode.
# Note: The default Windy Global engine is 100% keyless and requires no key.
OPENWEATHERMAP_API_KEY=
OPENWEATHER_API_KEY=
RADAR_API_KEY=

# Alternative AI Model Providers (Optional BYOK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# TWILIO SMS: Optional credentials for dispatching weather news reports directly via SMS.
# Configure TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and TWILIO_PHONE_NUMBER.
# If not configured, ClimaCast falls back to device-native SMS and WhatsApp sharing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Authorized User Identity & Machine Configuration
AUTHORIZED_USER_PHONE=
AUTHORIZED_USER_EMAIL=
AUTHORIZED_USER_NAME=
MACHINE_ID=
UNIQUE_USER_ID=

# SQLite Database Storage
SQLITE_DB_PATH=./climacast.sqlite

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
